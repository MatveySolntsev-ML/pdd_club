{
  "info": {
    "name": "ПДД Клуб — проверка REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Укажите username и password локального пользователя. Для Docker установите base_url=http://127.0.0.1."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Корень API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Есть ссылки на вопросы и темы\", () => { pm.expect(pm.response.json()).to.have.keys(\"users\", \"topics\", \"questions\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            ""
          ]
        }
      }
    },
    {
      "name": "Список тем",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ответ содержит список\", () => { const body = pm.response.json(); pm.expect(body.results ?? body).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/topics/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "topics",
            ""
          ]
        }
      }
    },
    {
      "name": "Список вопросов",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ответ содержит список\", () => { const body = pm.response.json(); pm.expect(body.results ?? body).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/questions/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "questions",
            ""
          ]
        }
      }
    },
    {
      "name": "Профиль без JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/me/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            ""
          ]
        }
      }
    },
    {
      "name": "Получение JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    const tokens = pm.response.json();",
              "    pm.test(\"Выданы access и refresh\", () => { pm.expect(tokens.access).to.be.a(\"string\"); pm.expect(tokens.refresh).to.be.a(\"string\"); });",
              "    pm.collectionVariables.set(\"access_token\", tokens.access);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/token/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Профиль с JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Профиль соответствует логину\", () => { pm.expect(pm.response.json().username).to.equal(pm.variables.get(\"username\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/me/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "me",
            ""
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Выгрузка списка на повторение",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Возвращается текстовый файл\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"); pm.expect(pm.response.headers.get(\"Content-Disposition\")).to.include(\"review_list.txt\"); });",
              "pm.collectionVariables.unset(\"access_token\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/review_list/download/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "review_list",
            "download",
            ""
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}
